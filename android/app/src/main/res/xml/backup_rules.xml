<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11(API 30) 이하 Auto Backup. 제외만 적는다 — include가 하나라도 있으면 나머지가 전부 빠진다.
     files/versions/ = capgo OTA 번들 압축 해제본(개당 약 9MB). 다시 받을 수 있고, 없으면 플러그인이 내장 번들로 돌아간다.
     app_webview/Default/Service Worker/ = 빵 변형 GLB 캐시(Cache API, 다 보면 약 36MB). 클라우드 백업 상한 25MB를 넘기면
     백업이 통째로 건너뛰어진다. 비면 remoteAssets가 다시 받는다. 이 파일은 API 30 이하 기기 간 이전에도 쓰인다(나눌 수 없음).
     세이브(WebView localStorage = app_webview/Default/Local Storage/, Preferences 미러 = shared_prefs/CapacitorStorage.xml)는 그대로 백업된다. -->
<full-backup-content>
    <exclude domain="file" path="versions/" />
    <exclude domain="root" path="app_webview/Default/Service Worker/" />
</full-backup-content>
